{
  "name": "epub-metadata-editor",
  "version": "0.0.1",
  "author": "Sheldrapps",
  "homepage": "https://sheldrapps.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ../../scripts/ensure-stencil-entry.cjs && node ../../scripts/patch-capacitor-status-bar.cjs && node ../../scripts/patch-capacitor-admob.cjs && node ../../scripts/patch-capacitor-android.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "assets:android": "node ../../scripts/run-capacitor-assets.cjs generate --android",
    "debugApk": "node ../../scripts/run-mobile-android-flow.cjs assembleDebug",
    "releaseApk": "node ../../scripts/run-mobile-android-flow.cjs assembleRelease",
    "bundleRelease": "node ../../scripts/run-mobile-android-flow.cjs bundleRelease"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "8.1.0",
    "@capacitor-community/admob": "8.0.0",
    "@capacitor/core": "8.4.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/angular": "8.8.14",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@sheldrapps/ads-kit": "workspace:*",
    "@sheldrapps/i18n-kit": "workspace:*",
    "@sheldrapps/rating-kit": "workspace:*",
    "@sheldrapps/settings-kit": "workspace:*",
    "@sheldrapps/ui-theme": "workspace:*",
    "ionicons": "^7.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/language-service": "^22.0.7",
    "@capacitor/cli": "8.4.2",
    "@ionic/angular-toolkit": "^12.3.0",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^48.2.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~6.0.3"
  },
  "description": "An Ionic project"
}
